#!/system/bin/sh
# Jacktor Audio Framework - Linux MOTD & Telemetry Generator
# Ubuntu Server Layout with Jacktor Telemetry

_REQ_USER="${1:-$USER}"
[ -z "$_REQ_USER" ] && _REQ_USER="root"
_HOST="${2:-127.0.0.1}"

# ANSI Color Codes
C_RST="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_WHITE="\033[1;37m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_GRAY="\033[0;37m"
C_YELLOW="\033[1;33m"

_KERNEL="$(uname -r 2>/dev/null)"
[ -z "$_KERNEL" ] && _KERNEL="4.19.152-perf+"
_ARCH="$(uname -m 2>/dev/null)"
[ -z "$_ARCH" ] && _ARCH="aarch64"
_DATE="$(date 2>/dev/null)"
[ -z "$_DATE" ] && _DATE="$(date '+%a %b %e %T %Z %Y' 2>/dev/null)"

# 1. System Load
_LOAD="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
[ -z "$_LOAD" ] && _LOAD="0.00"

# 2. Processes Count
_PROCS="$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)"
if [ "$_PROCS" -gt 20 ] 2>/dev/null; then
    echo "$_PROCS" > /data/adb/ssh/proc_count 2>/dev/null
    chmod 644 /data/adb/ssh/proc_count 2>/dev/null
elif [ -f /data/adb/ssh/proc_count ]; then
    _PROCS="$(cat /data/adb/ssh/proc_count 2>/dev/null)"
fi
[ -z "$_PROCS" ] || [ "$_PROCS" -lt 1 ] 2>/dev/null && _PROCS="765"

# 3. Active Users
_USERS="$(ps -A 2>/dev/null | grep -E 'sshd-session|pts' | grep -v grep | wc -l)"
[ -z "$_USERS" ] || [ "$_USERS" -lt 1 ] 2>/dev/null && _USERS="1"

# 4. Storage Usage (/data)
eval $(df -k /data 2>/dev/null | tail -n 1 | awk '{printf "_DUSED=%.1fGB _DTOTAL=%.1fGB _DPCT=%s\n", $3/1048576, $2/1048576, $5}')
[ -z "$_DPCT" ] && _DPCT="8%"
[ -z "$_DTOTAL" ] && _DTOTAL="48.1GB"
[ -z "$_DUSED" ] && _DUSED="3.7GB"

# 5. Memory & Swap (ZRAM)
eval $(awk '
/MemTotal:/ { total=$2 }
/MemAvailable:/ { avail=$2 }
/SwapTotal:/ { stotal=$2 }
/SwapFree:/ { sfree=$2 }
END {
    used = total - avail
    pct = (total > 0) ? int((used * 100) / total) : 0
    sused = stotal - sfree
    spct = (stotal > 0) ? int((sused * 100) / stotal) : 0
    printf "_MPCT=%d%% _MUSED=%.1fGB _MTOTAL=%.1fGB _SPCT=%d%% _SUSED=%.0fMB _STOTAL=%.1fGB\n", pct, used/1048576, total/1048576, spct, sused/1024, stotal/1048576
}' /proc/meminfo 2>/dev/null)
[ -z "$_MPCT" ] && _MPCT="44%"
[ -z "$_MUSED" ] && _MUSED="1.6GB"
[ -z "$_MTOTAL" ] && _MTOTAL="3.6GB"
[ -z "$_SPCT" ] && _SPCT="21%"
[ -z "$_SUSED" ] && _SUSED="541MB"
[ -z "$_STOTAL" ] && _STOTAL="2.5GB"

# 6. Temperature
_TEMP="$(awk '{printf "%.1f°C", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
[ -z "$_TEMP" ] && _TEMP="$(awk '{printf "%.1f°C", $1/1000}' /sys/class/thermal/thermal_zone10/temp 2>/dev/null)"
[ -z "$_TEMP" ] && _TEMP="37.0°C"

# 7. Uptime
_UPTIME="$(awk '{up=$1; d=int(up/86400); h=int((up%86400)/3600); m=int((up%3600)/60); if(d>0) printf "%d days, %d hours, %d mins", d, h, m; else if(h>0) printf "%d hours, %d mins", h, m; else printf "%d mins", m}' /proc/uptime 2>/dev/null)"
[ -z "$_UPTIME" ] && _UPTIME="N/A"

# 8. Header
printf "%bWelcome to Jacktor Audio Framework on Realme C15 (GNU/Linux %s %s)%b\n\n" "$C_WHITE" "$_KERNEL" "$_ARCH" "$C_RST"

# 9. ASCII Logo + Aligned Metadata Banner (Cols: Logo 42 chars | Label 15 chars | Value)
printf "%b       _            _    _                %b%-15s %b%s%b\n" "$C_CYAN" "$C_GRAY" "OS:" "$C_WHITE" "Android 14 (GSI)" "$C_RST"
printf "%b      | | __ _  ___| | _| |_ ___  _ __    %b%-15s %b%s%b\n" "$C_CYAN" "$C_GRAY" "Device:" "$C_WHITE" "Realme C15 (Bengal SM4250)" "$C_RST"
printf "%b _    | |/ _\` |/ __| |/ / __/ _ \\| '__|   %b%-15s %b%s (%s)%b\n" "$C_CYAN" "$C_GRAY" "Kernel:" "$C_WHITE" "$_KERNEL" "$_ARCH" "$C_RST"
printf "%b| |___| | (_| | (__|   <| || (_) | |      %b%-15s %b%s (Port 22)%b\n" "$C_CYAN" "$C_GRAY" "Host Address:" "$C_WHITE" "$_HOST" "$C_RST"
printf "%b \\_____/ \\__,_|\\___|_|\\_\\\\__\\___/|_|       %b%-15s %b%s%b\n" "$C_CYAN" "$C_GRAY" "Remote Access:" "$C_WHITE" "OpenSSH 10.3p1" "$C_RST"

# 10. Ubuntu-style System Information Header
printf "\n  System information as of %s\n\n" "$_DATE"

# 11. 2-Column Telemetry Table (Without Battery, matching Ubuntu Server)
_VAL_MEM="${_MPCT} (${_MUSED} / ${_MTOTAL})"
_VAL_SWAP="${_SPCT} (${_SUSED} / ${_STOTAL})"
_VAL_DISK="${_DPCT} of ${_DTOTAL}"

printf "  %b%-16s%b %-21s %b%-25s%b %s\n" "$C_GRAY" "System load:" "$C_WHITE" "$_LOAD" "$C_GRAY" "Processes:" "$C_WHITE" "$_PROCS"
printf "  %b%-16s%b %-21s %b%-25s%b %s\n" "$C_GRAY" "Usage of /data:" "$C_WHITE" "$_VAL_DISK" "$C_GRAY" "Users logged in:" "$C_WHITE" "$_USERS"
printf "  %b%-16s%b %-21s %b%-25s%b %s\n" "$C_GRAY" "Memory usage:" "$C_WHITE" "$_VAL_MEM" "$C_GRAY" "IPv4 address for wlan0:" "$C_WHITE" "$_HOST"
printf "  %b%-16s%b %-21s %b%-25s%b %s\n" "$C_GRAY" "Swap / ZRAM:" "$C_WHITE" "$_VAL_SWAP" "$C_GRAY" "Temperature:" "$C_WHITE" "$_TEMP"
printf "  %b%-16s%b %-21s\n" "$C_GRAY" "System uptime:" "$C_WHITE" "$_UPTIME"

# 12. Service Status Bullets (Ubuntu style)
printf "\n %b*%b Audio Stream:   384kHz / 32-bit (ALSA Bit-Perfect Direct)\n" "$C_GREEN" "$C_RST"
printf " %b*%b USB Engine:     Auto / Host Mode Active\n" "$C_GREEN" "$C_RST"
printf " %b*%b Webroot UI:     http://%s/ (Port 80)\n" "$C_GREEN" "$C_RST" "$_HOST"
printf " %b*%b Diagnostics:    Run 'amp-status' for hardware and amplifier telemetry\n\n" "$C_GREEN" "$C_RST"
